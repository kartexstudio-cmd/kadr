# Публичный адрес сайта (используется для canonical, OG и sitemap)
NEXT_PUBLIC_SITE_URL=https://nitroreel.net

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Service role key. Только серверный. НИКОГДА не префиксовать NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Уведомления о заявках. Токен — от @BotFather, chat id — от @userinfobot.
# Секреты, тоже без префикса NEXT_PUBLIC_. Если пусто — уведомления не отправляются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Секрет для /api/keepalive — Vercel Cron присылает его в заголовке Authorization.
CRON_SECRET=

# Чат-виджет поддержки (/api/chat) — бесплатный тир Google Gemini.
# Получить ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
